{
  "contract_id": "dev-orchestration",
  "schema_version": "1.1.0",
  "authority_source": "tasks-owner",
  "compatible_skills": {
    "pmo": {
      "tested_artifact_version": "0.10.0",
      "minimum_compatible_version": "0.10.0",
      "required_contract_schema_major": 1
    },
    "tasks-owner": {
      "tested_artifact_version": "0.24.0",
      "minimum_compatible_version": "0.24.0",
      "required_contract_schema_major": 1
    }
  },
  "capabilities": [
    "pmo_admission",
    "owner_sparse_delta",
    "single_scope_owner_execution",
    "bounded_finding_fix",
    "delivery_closeout",
    "product_frontier_closure",
    "bounded_execution_retrospective",
    "skill_feedback_candidate",
    "native_skill_feedback"
  ],
  "owner_mandate": {
    "required_fields": [
      "authority_origin",
      "scope_kind",
      "scope_locator",
      "global_tradeoff_authority"
    ],
    "authority_origin": ["user", "pmo"],
    "scope_kind": ["project_scope", "work_item"]
  },
  "unit_identity": {
    "required_fields": [
      "product_exit_locator",
      "governing_invariant_locator",
      "ownership_boundary_locator",
      "convergence_chain_locator"
    ],
    "cannot_reset_by": [
      "file",
      "path",
      "issue",
      "pull_request",
      "branch",
      "head",
      "reviewer",
      "execution_generation"
    ],
    "new_chain_requires": [
      "product_exit_change",
      "acceptance_change",
      "scope_change",
      "ownership_change"
    ]
  },
  "writer_admission": {
    "required_unit_identity_fields": [
      "product_exit_locator",
      "governing_invariant_locator",
      "ownership_boundary_locator",
      "convergence_chain_locator"
    ]
  },
  "systemic_invariant_closure": {
    "required_fields": [
      "governing_invariant_locator",
      "subject",
      "coverage",
      "ordering",
      "failure",
      "surfaces",
      "invariant_closure_digest",
      "status"
    ],
    "surface_required_fields": [
      "lifecycle_surface",
      "implementation_variant",
      "consumer_or_effect",
      "code_locator",
      "positive_check",
      "negative_or_unavailable_check",
      "no_side_effect_check",
      "status",
      "basis"
    ],
    "surface_status": ["covered", "not_applicable"],
    "closure_status": ["ready", "incomplete", "invalidated"]
  },
  "pmo_admission": {
    "required_fields": [
      "contract_id",
      "schema_version",
      "authority_origin",
      "scope_kind",
      "scope_locator",
      "planning_truth_locator",
      "product_goal",
      "expected_contribution",
      "acceptance_locator",
      "product_exit_locator",
      "governing_invariant_locator",
      "convergence_chain_locator",
      "ownership_boundary_locator",
      "allowed_scope",
      "excluded_scope",
      "carrier_locator",
      "target_head_locator",
      "decision_boundary_locator",
      "repair_budget"
    ]
  },
  "owner_sparse_delta": {
    "allowed_kinds": [
      "product_effect",
      "local_blocker",
      "finding_effect",
      "material_scope_change",
      "invariant_coverage_invalidated",
      "convergence_decision_needed",
      "next_unlock",
      "unit_completed",
      "decision_required"
    ],
    "required_fields": [
      "kind",
      "unit_locator",
      "product_exit_locator",
      "evidence_locator",
      "next_actor",
      "next_action"
    ],
    "forbidden_kinds": [
      "commit",
      "test_passed",
      "review_started",
      "heartbeat",
      "thread_active"
    ]
  },
  "product_frontier": {
    "required_fields": [
      "product_exit_locators",
      "gaps",
      "frontier_closure_status"
    ],
    "gap_required_fields": [
      "gap_locator",
      "product_exit_locator",
      "classification",
      "owner_or_next_actor",
      "evidence_locator",
      "wake_condition",
      "invalidation_condition"
    ],
    "classifications": [
      "execution_ready",
      "admission_pending",
      "active_execution",
      "waiting_external",
      "waiting_user",
      "replan_or_reownership_pending",
      "closeout_pending"
    ],
    "owner_actionable_classifications": [
      "execution_ready",
      "admission_pending",
      "replan_or_reownership_pending",
      "closeout_pending"
    ],
    "waiting_proof_required_fields": [
      "subject",
      "external_condition",
      "responsible_party",
      "evidence_locator",
      "observed_at",
      "freshness",
      "wake_condition",
      "invalidation_condition"
    ],
    "closure_status": ["complete", "incomplete"],
    "whole_cycle_wait_allowed_classifications": [
      "active_execution",
      "waiting_external",
      "waiting_user"
    ],
    "recompute_triggers": [
      "user_correction",
      "unit_merge_or_closeout",
      "dependency_resolution",
      "owner_terminal",
      "waiting_proof_invalidation",
      "long_lived_single_writer_with_unfinished_exit",
      "deep_audit"
    ]
  },
  "execution_retrospective": {
    "triggers": [
      "user_correction",
      "explicit_skill_correction",
      "repeated_failure",
      "post_repair_recurrence",
      "no_product_progress",
      "scope_dependency_ownership_drift",
      "source_of_truth_conflict",
      "repeated_platform_assumption_failure",
      "high_impact_incident"
    ],
    "root_cause_targets": ["project", "planning", "skill", "platform"],
    "candidate_required_fields": [
      "affected_skill",
      "trigger",
      "observed_behavior",
      "expected_behavior",
      "product_impact",
      "current_resolution",
      "generalizable_reason",
      "regression_proposal",
      "source_locator",
      "disclosure_status",
      "fingerprint_seed"
    ],
    "ordering": [
      "current_product_recovery",
      "frontier_or_owner_correction",
      "retrospective",
      "root_cause_classification",
      "feedback_candidate"
    ],
    "explicit_skill_correction_requires_repetition": false,
    "heartbeat_is_recovery_only": true
  },
  "skill_feedback": {
    "canonical_repositories": {
      "pmo": "MC-and-his-Agents/MC-AGENT-KIT",
      "tasks-owner": "MC-and-his-Agents/MC-AGENT-KIT"
    },
    "canonical_issue_form": ".github/ISSUE_TEMPLATE/skill-feedback.yml",
    "allowed_actions": [
      "search_issue",
      "read_issue",
      "create_issue",
      "add_comment"
    ],
    "forbidden_actions": [
      "write_code",
      "create_branch",
      "create_pull_request",
      "merge_pull_request",
      "create_release",
      "close_issue",
      "delete_issue",
      "update_milestone",
      "update_labels",
      "update_assignees",
      "change_permissions",
      "install_skill",
      "update_skill",
      "reload_skill"
    ],
    "submission_preconditions": [
      "skill_identity_match",
      "canonical_repository_match",
      "github_feedback_capability_available",
      "dedupe_complete",
      "redaction_safe"
    ],
    "core_semantic_fields": [
      "affected_skill",
      "retrospective_trigger",
      "observed_behavior",
      "expected_behavior",
      "product_impact",
      "current_resolution",
      "generalizable_root_cause",
      "proposed_regression",
      "redacted_evidence",
      "fingerprint_occurrence"
    ],
    "fingerprint_fields": [
      "affected_skill",
      "incident_root_cause_class",
      "governing_behavior_category",
      "platform_contract_major"
    ],
    "fingerprint_occurrence_required_fields": [
      "fingerprint",
      "occurrence"
    ],
    "new_issue_occurrence": "first_occurrence",
    "fingerprint_forbidden_fields": [
      "branch",
      "pull_request",
      "head",
      "owner",
      "unit",
      "execution_generation",
      "heartbeat"
    ],
    "occurrence_comment_fields": [
      "source_locator",
      "product_impact",
      "current_resolution",
      "root_cause_delta",
      "regression_delta"
    ],
    "checkpoint_fields": [
      "feedback_fingerprint",
      "feedback_issue_locator",
      "last_occurrence_locator",
      "feedback_status",
      "next_action"
    ],
    "feedback_status": [
      "none",
      "candidate",
      "deduped",
      "submitted",
      "deferred_private"
    ],
    "feedback_target": ["pmo", "tasks-owner", "platform", "none"],
    "failure_status": {
      "candidate": [
        "dedupe_incomplete",
        "tool_unavailable",
        "write_failed",
        "readback_unavailable"
      ],
      "deferred_private": [
        "redaction_unsafe",
        "canonical_repository_mismatch",
        "skill_identity_mismatch",
        "action_not_allowed"
      ]
    },
    "submission_required_fields": [
      "feedback_write_action",
      "feedback_submission_locator",
      "feedback_readback_verified",
      "skill_digest_unchanged"
    ],
    "legacy_authority_input": "ignored_for_canonical_repository; non-canonical writes use ordinary user authorization",
    "api_body_must_be_explicit": true,
    "issue_is_only_long_term_retrospective_body": true,
    "does_not_change_product_semantic_revision": true,
    "does_not_change_current_skill_digest": true
  },
  "invalidation": [
    "contract_locator_unreadable",
    "schema_version_unsupported",
    "required_capability_missing",
    "scope_or_authority_conflict",
    "target_head_identity_changed"
  ]
}
